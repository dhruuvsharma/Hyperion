{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daxalgo.local/schemas/hyperion/training-artifact.v1.schema.json",
  "title": "Hyperion sealed training artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactSha256",
    "fileTreeSha256",
    "recordedAtUtc",
    "runId",
    "mode",
    "productionEligible",
    "reason",
    "manifestSha256",
    "dataRelease",
    "baseModel",
    "datasetSnapshot",
    "files",
    "environment"
  ],
  "properties": {
    "schemaVersion": {"const": "daxalgo.hyperion.training-artifact/v1"},
    "artifactSha256": {"$ref": "#/$defs/sha256"},
    "fileTreeSha256": {"$ref": "#/$defs/sha256"},
    "recordedAtUtc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "runId": {"type": "string", "pattern": "^vqrun-[0-9a-f]{20}$"},
    "mode": {"enum": ["smoke", "unpromoted-candidate", "unpromoted-research"]},
    "productionEligible": {"const": false},
    "reason": {"type": "string", "minLength": 1},
    "manifestSha256": {"$ref": "#/$defs/sha256"},
    "dataRelease": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/releaseIdentity"}
      ]
    },
    "baseModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateId", "modelId", "revision"],
      "properties": {
        "candidateId": {"type": "string", "minLength": 1, "maxLength": 200},
        "modelId": {"type": "string", "minLength": 1, "maxLength": 500},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "datasetSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "recordCount"],
      "properties": {
        "path": {"const": "inputs/dataset.sft.jsonl"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "recordCount": {"type": "integer", "minimum": 1, "maximum": 100000}
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {"$ref": "#/$defs/file"},
      "allOf": [
        {"contains": {"type": "object", "required": ["path"], "properties": {"path": {"const": "adapter_config.json"}}}},
        {"contains": {"type": "object", "required": ["path"], "properties": {"path": {"const": "adapter_model.safetensors"}}}},
        {"contains": {"type": "object", "required": ["path"], "properties": {"path": {"const": "special_tokens_map.json"}}}},
        {"contains": {"type": "object", "required": ["path"], "properties": {"path": {"const": "tokenizer.json"}}}},
        {"contains": {"type": "object", "required": ["path"], "properties": {"path": {"const": "tokenizer_config.json"}}}},
        {
          "if": {"contains": {"type": "object", "required": ["path"], "properties": {"path": {"const": "vocab.json"}}}},
          "then": {"contains": {"type": "object", "required": ["path"], "properties": {"path": {"const": "merges.txt"}}}}
        },
        {
          "if": {"contains": {"type": "object", "required": ["path"], "properties": {"path": {"const": "merges.txt"}}}},
          "then": {"contains": {"type": "object", "required": ["path"], "properties": {"path": {"const": "vocab.json"}}}}
        }
      ]
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "platform", "dependencyVersions", "computeDtype", "gpu"],
      "properties": {
        "python": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "implementation", "executable"],
          "properties": {
            "version": {"type": "string", "minLength": 1, "maxLength": 100},
            "implementation": {"type": "string", "minLength": 1, "maxLength": 100},
            "executable": {"type": "string", "minLength": 1, "maxLength": 4096}
          }
        },
        "platform": {
          "type": "object",
          "additionalProperties": false,
          "required": ["description", "system", "release", "machine"],
          "properties": {
            "description": {"type": "string", "minLength": 1, "maxLength": 1000},
            "system": {"type": "string", "minLength": 1, "maxLength": 1000},
            "release": {"type": "string", "minLength": 1, "maxLength": 1000},
            "machine": {"type": "string", "minLength": 1, "maxLength": 1000}
          }
        },
        "dependencyVersions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["torch", "transformers", "datasets", "peft", "trl", "accelerate", "bitsandbytes", "cryptography"],
          "properties": {
            "torch": {"$ref": "#/$defs/version"},
            "transformers": {"$ref": "#/$defs/version"},
            "datasets": {"$ref": "#/$defs/version"},
            "peft": {"$ref": "#/$defs/version"},
            "trl": {"$ref": "#/$defs/version"},
            "accelerate": {"$ref": "#/$defs/version"},
            "bitsandbytes": {"$ref": "#/$defs/version"},
            "cryptography": {"$ref": "#/$defs/version"}
          }
        },
        "computeDtype": {"enum": ["bfloat16", "float16"]},
        "gpu": {"$ref": "#/$defs/gpu"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "smoke"}}},
      "then": {"properties": {"reason": {"const": "Smoke mode cannot produce a production model."}}}
    },
    {
      "if": {"properties": {"mode": {"const": "unpromoted-candidate"}}},
      "then": {
        "properties": {
          "reason": {"const": "Training alone does not satisfy evaluation, promotion, signing, or deployment gates."},
          "dataRelease": {"$ref": "#/$defs/releaseIdentity"},
          "environment": {
            "properties": {
              "gpu": {"properties": {"memoryGateWaivedForSmoke": {"const": false}}}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"mode": {"const": "unpromoted-research"}}},
      "then": {
        "properties": {
          "reason": {"const": "Research-only training cannot produce promotion-eligible evidence."},
          "dataRelease": {"type": "null"},
          "environment": {
            "properties": {
              "gpu": {"properties": {"memoryGateWaivedForSmoke": {"const": false}}}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "releaseIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["releaseId", "releaseSha256", "manifestSha256"],
      "properties": {
        "releaseId": {"type": "string", "pattern": "^vqrel-[0-9a-f]{64}$"},
        "releaseSha256": {"$ref": "#/$defs/sha256"},
        "manifestSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "version": {"type": "string", "minLength": 1, "maxLength": 200},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "sizeBytes"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "enum": ["README.md", "adapter_config.json", "adapter_model.safetensors", "added_tokens.json", "chat_template.jinja", "merges.txt", "special_tokens_map.json", "tokenizer.json", "tokenizer_config.json", "vocab.json"]
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "sizeBytes": {"type": "integer", "minimum": 0, "maximum": 50000000000}
      }
    },
    "gpu": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cudaAvailable",
        "deviceCount",
        "largestGpuGiB",
        "requiredGpuGiB",
        "memoryGateWaivedForSmoke",
        "devices",
        "cudaRuntimeVersion",
        "productionEligible"
      ],
      "properties": {
        "cudaAvailable": {"const": true},
        "deviceCount": {"type": "integer", "minimum": 1, "maximum": 256},
        "largestGpuGiB": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000000},
        "requiredGpuGiB": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000000},
        "memoryGateWaivedForSmoke": {"type": "boolean"},
        "devices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {"$ref": "#/$defs/gpuDevice"}
        },
        "cudaRuntimeVersion": {"type": ["string", "null"], "maxLength": 200},
        "productionEligible": {"const": false}
      }
    },
    "gpuDevice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "name", "totalMemoryGiB", "computeCapability", "multiProcessorCount"],
      "properties": {
        "index": {"type": "integer", "minimum": 0, "maximum": 255},
        "name": {"type": "string", "minLength": 1, "maxLength": 500},
        "totalMemoryGiB": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000000},
        "computeCapability": {"type": ["string", "null"], "pattern": "^[0-9]+\\.[0-9]+$"},
        "multiProcessorCount": {"type": ["integer", "null"], "minimum": 1, "maximum": 1000000}
      }
    }
  }
}
