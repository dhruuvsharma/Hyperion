{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daxalgo.local/schemas/hyperion/candidate-catalog.v1.schema.json",
  "title": "Hyperion model candidate catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogVersion", "candidates"],
  "properties": {
    "schemaVersion": {"const": "daxalgo.hyperion.candidate-catalog/v1"},
    "catalogVersion": {"const": "1.0.0"},
    "candidates": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "displayName",
          "modelId",
          "revision",
          "license",
          "licenseUrl",
          "officialSourceUrl",
          "roles"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "displayName": {"type": "string", "minLength": 1},
          "modelId": {"type": "string", "minLength": 1},
          "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "license": {"const": "Apache-2.0"},
          "licenseUrl": {"const": "https://www.apache.org/licenses/LICENSE-2.0"},
          "officialSourceUrl": {"type": "string", "format": "uri", "pattern": "^https://"},
          "roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["student", "teacher", "fallback"]}
          }
        }
      }
    }
  }
}

