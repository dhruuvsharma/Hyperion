{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daxalgo.local/schemas/hyperion/verifier-result.v1.schema.json",
  "title": "Hyperion ingested verifier result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "resultSha256", "runId", "taskId", "taskSha256", "responseSha256", "verifierId", "verifierSha256", "checks", "accepted"],
  "properties": {
    "schemaVersion": {"const": "daxalgo.hyperion.verifier-result/v1"},
    "resultSha256": {"$ref": "#/$defs/sha256"},
    "runId": {"$ref": "#/$defs/id"},
    "taskId": {"$ref": "#/$defs/id"},
    "taskSha256": {"$ref": "#/$defs/sha256"},
    "responseSha256": {"$ref": "#/$defs/sha256"},
    "verifierId": {"$ref": "#/$defs/id"},
    "verifierSha256": {"$ref": "#/$defs/sha256"},
    "checks": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"type": "object", "additionalProperties": false, "required": ["checkId", "passed", "evidence", "evidenceSha256"], "properties": {"checkId": {"$ref": "#/$defs/id"}, "passed": {"type": "boolean"}, "evidence": {"type": "string", "minLength": 1}, "evidenceSha256": {"$ref": "#/$defs/sha256"}}}},
    "accepted": {"type": "boolean"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
