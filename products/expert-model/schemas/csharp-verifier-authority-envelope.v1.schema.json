{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daxalgo.local/schemas/hyperion/csharp-verifier-authority-envelope.v1.schema.json",
  "title": "Hyperion signed C# verifier authority envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "payloadType", "payloadEncoding", "payloadSha256", "payload", "algorithm", "signatureFormat", "audience", "keyId", "signerRole", "publicKeySpkiSha256", "signature"],
  "properties": {
    "schemaVersion": {"const": "daxalgo.hyperion.csharp-verifier-authority-envelope/v1"},
    "payloadType": {"const": "daxalgo.hyperion.csharp-verifier-authority/v1"},
    "payloadEncoding": {"const": "canonical-json-base64url"},
    "payloadSha256": {"$ref": "#/$defs/sha256"},
    "payload": {"type": "string", "minLength": 1, "maxLength": 262144, "pattern": "^[A-Za-z0-9_-]+$"},
    "algorithm": {"const": "ES256"},
    "signatureFormat": {"const": "ieee-p1363-low-s"},
    "audience": {"$ref": "#/$defs/id"},
    "keyId": {"$ref": "#/$defs/id"},
    "signerRole": {"$ref": "#/$defs/id"},
    "publicKeySpkiSha256": {"$ref": "#/$defs/sha256"},
    "signature": {"type": "string", "minLength": 86, "maxLength": 86, "pattern": "^[A-Za-z0-9_-]{86}$"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
