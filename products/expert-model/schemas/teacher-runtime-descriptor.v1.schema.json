{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daxalgo.local/schemas/hyperion/teacher-runtime-descriptor.v1.schema.json",
  "title": "Hyperion teacher runtime descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "candidateId", "profileVersion", "engineVersion", "modelRoot", "maxModelLen", "baseUrl", "chatTemplatePath"],
  "properties": {
    "schemaVersion": {"const": "daxalgo.hyperion.teacher-runtime-descriptor/v1"},
    "candidateId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"},
    "profileVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "allOf": [
        {"not": {"pattern": "^(?:[Mm][Aa][Ii][Nn]|[Mm][Aa][Ss][Tt][Ee][Rr]|[Ll][Aa][Tt][Ee][Ss][Tt]|[Tt][Rr][Uu][Nn][Kk])$"}},
        {"not": {"pattern": "[Rr][Ee][Pp][Ll][Aa][Cc][Ee]_"}}
      ]
    },
    "engineVersion": {"enum": ["0.10.0", "0.26.0"]},
    "modelRoot": {"type": "string", "minLength": 1, "maxLength": 2000},
    "maxModelLen": {"type": "integer", "minimum": 1, "maximum": 1048576},
    "baseUrl": {"type": "string", "pattern": "^http://127\\.0\\.0\\.1:(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])/v1$"},
    "chatTemplatePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*//)(?!.*\\/$)(?!\\.\\.?$)(?!\\.\\.?/)(?!.*\\/\\.\\.?(?:\\/|$)).+$"
    }
  }
}
