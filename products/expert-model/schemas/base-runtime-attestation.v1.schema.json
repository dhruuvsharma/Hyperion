{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daxalgo.local/schemas/hyperion/base-runtime-attestation.v1.schema.json",
  "title": "Hyperion raw-base runtime attestation payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "attestationId", "decision", "audience", "keyId", "signerRole", "activation", "wrapperInstanceId", "sequence", "nonce", "evaluation", "requestSha256", "completionSha256", "model", "engine", "issuedAtUtc", "expiresAtUtc"],
  "properties": {
    "schemaVersion": {"const": "daxalgo.hyperion.base-runtime-attestation/v1"},
    "attestationId": {"type": "string", "pattern": "^vqbaseatt-[0-9a-f]{64}$"},
    "decision": {"const": "attested-base-completion"},
    "audience": {"$ref": "#/$defs/id"},
    "keyId": {"$ref": "#/$defs/id"},
    "signerRole": {"$ref": "#/$defs/id"},
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activationId", "envelopeSha256", "payloadSha256"],
      "properties": {
        "activationId": {"type": "string", "pattern": "^vqbaseact-[0-9a-f]{64}$"},
        "envelopeSha256": {"$ref": "#/$defs/sha256"},
        "payloadSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "wrapperInstanceId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "nonce": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
    "evaluation": {"$ref": "#/$defs/evaluation"},
    "requestSha256": {"$ref": "#/$defs/sha256"},
    "completionSha256": {"$ref": "#/$defs/sha256"},
    "model": {"$ref": "#/$defs/model"},
    "engine": {"$ref": "#/$defs/engine"},
    "issuedAtUtc": {"$ref": "#/$defs/utc"},
    "expiresAtUtc": {"$ref": "#/$defs/utc"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "utc": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["releaseId", "releaseSha256", "manifestSha256"],
      "properties": {
        "releaseId": {"type": "string", "pattern": "^vqrel-[0-9a-f]{64}$"},
        "releaseSha256": {"$ref": "#/$defs/sha256"},
        "manifestSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "taskId", "taskSha256", "promptSha256", "dataRelease"],
      "properties": {
        "runId": {"$ref": "#/$defs/id"},
        "taskId": {"$ref": "#/$defs/id"},
        "taskSha256": {"$ref": "#/$defs/sha256"},
        "promptSha256": {"$ref": "#/$defs/sha256"},
        "dataRelease": {"$ref": "#/$defs/release"}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateCatalogSha256", "candidateId", "modelId", "modelRevision", "servingProfileSha256", "executionModelId", "sourceLockSha256", "snapshotManifestSha256", "snapshotSha256", "fileTreeSha256"],
      "properties": {
        "candidateCatalogSha256": {"$ref": "#/$defs/sha256"},
        "candidateId": {"$ref": "#/$defs/id"},
        "modelId": {"type": "string", "minLength": 1, "maxLength": 500},
        "modelRevision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "servingProfileSha256": {"$ref": "#/$defs/sha256"},
        "executionModelId": {"$ref": "#/$defs/id"},
        "sourceLockSha256": {"$ref": "#/$defs/sha256"},
        "snapshotManifestSha256": {"$ref": "#/$defs/sha256"},
        "snapshotSha256": {"$ref": "#/$defs/sha256"},
        "fileTreeSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wrapperConfigSha256", "wrapperPackageSha256", "executableSha256", "engineVersion", "containerImageDigest", "processId", "argvSha256"],
      "properties": {
        "wrapperConfigSha256": {"$ref": "#/$defs/sha256"},
        "wrapperPackageSha256": {"$ref": "#/$defs/sha256"},
        "executableSha256": {"$ref": "#/$defs/sha256"},
        "engineVersion": {"enum": ["0.10.0", "0.26.0"]},
        "containerImageDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "processId": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "argvSha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
