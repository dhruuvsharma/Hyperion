{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daxalgo.local/schemas/hyperion/verifier-decision-manifest.v1.schema.json",
  "title": "Hyperion verifier decision manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "inputs", "decisions"],
  "properties": {
    "schemaVersion": {"const": "daxalgo.hyperion.verifier-decision-manifest/v1"},
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskSetSha256", "responseSetSha256"],
      "properties": {
        "taskSetSha256": {"$ref": "#/$defs/sha256"},
        "responseSetSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/decision"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "responseSha256", "checks"],
      "properties": {
        "taskId": {"$ref": "#/$defs/id"},
        "responseSha256": {"$ref": "#/$defs/sha256"},
        "checks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/check"}
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkId", "passed", "evidence"],
      "properties": {
        "checkId": {"$ref": "#/$defs/id"},
        "passed": {"type": "boolean"},
        "evidence": {"type": "string", "minLength": 1, "maxLength": 200000}
      }
    }
  }
}
