{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daxalgo.local/schemas/hyperion/base-model-selection.v1.schema.json",
  "title": "DaxAlgo base-model training selection payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "selectionId",
    "decision",
    "trainingAuthorized",
    "issuedAtUtc",
    "notBeforeUtc",
    "expiresAtUtc",
    "dataRelease",
    "evaluation",
    "selected",
    "approval",
    "statement"
  ],
  "properties": {
    "schemaVersion": {"const": "daxalgo.hyperion.base-model-selection/v1"},
    "selectionId": {"type": "string", "pattern": "^vqbaseselect-[0-9a-f]{64}$"},
    "decision": {"const": "approved-training-base"},
    "trainingAuthorized": {"const": true},
    "issuedAtUtc": {"$ref": "#/$defs/utc"},
    "notBeforeUtc": {"$ref": "#/$defs/utc"},
    "expiresAtUtc": {"$ref": "#/$defs/utc"},
    "dataRelease": {"$ref": "#/$defs/release"},
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reportSha256",
        "reportFileSha256",
        "policySha256",
        "policyFileSha256",
        "calibrationTasksFileSha256",
        "calibrationTaskSetSha256",
        "calibrationEvidenceSha256",
        "sealedTasksFileSha256",
        "sealedTaskSetSha256",
        "candidateResponsesFileSha256",
        "candidateResponseSetSha256",
        "candidateVerifierResultsFileSha256",
        "candidateVerifierResultSetSha256",
        "baselineResponsesFileSha256",
        "baselineResponseSetSha256",
        "baselineVerifierResultsFileSha256",
        "baselineVerifierResultSetSha256",
        "candidateRun",
        "baselineRun"
      ],
      "properties": {
        "reportSha256": {"$ref": "#/$defs/sha256"},
        "reportFileSha256": {"$ref": "#/$defs/sha256"},
        "policySha256": {"$ref": "#/$defs/sha256"},
        "policyFileSha256": {"$ref": "#/$defs/sha256"},
        "calibrationTasksFileSha256": {"$ref": "#/$defs/sha256"},
        "calibrationTaskSetSha256": {"$ref": "#/$defs/sha256"},
        "calibrationEvidenceSha256": {"$ref": "#/$defs/sha256"},
        "sealedTasksFileSha256": {"$ref": "#/$defs/sha256"},
        "sealedTaskSetSha256": {"$ref": "#/$defs/sha256"},
        "candidateResponsesFileSha256": {"$ref": "#/$defs/sha256"},
        "candidateResponseSetSha256": {"$ref": "#/$defs/sha256"},
        "candidateVerifierResultsFileSha256": {"$ref": "#/$defs/sha256"},
        "candidateVerifierResultSetSha256": {"$ref": "#/$defs/sha256"},
        "baselineResponsesFileSha256": {"$ref": "#/$defs/sha256"},
        "baselineResponseSetSha256": {"$ref": "#/$defs/sha256"},
        "baselineVerifierResultsFileSha256": {"$ref": "#/$defs/sha256"},
        "baselineVerifierResultSetSha256": {"$ref": "#/$defs/sha256"},
        "candidateRun": {"$ref": "#/$defs/candidateRun"},
        "baselineRun": {"$ref": "#/$defs/run"}
      }
    },
    "selected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateCatalogSha256",
        "candidateId",
        "modelId",
        "modelRevision",
        "profileId",
        "profileSha256",
        "executionModelId",
        "sourceLockSha256",
        "snapshotManifestSha256",
        "snapshotSha256",
        "fileTreeSha256",
        "chatTemplateSha256"
      ],
      "properties": {
        "candidateCatalogSha256": {"$ref": "#/$defs/sha256"},
        "candidateId": {"$ref": "#/$defs/id"},
        "modelId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,499}$"},
        "modelRevision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "profileId": {"$ref": "#/$defs/id"},
        "profileSha256": {"$ref": "#/$defs/sha256"},
        "executionModelId": {"$ref": "#/$defs/id"},
        "sourceLockSha256": {"$ref": "#/$defs/sha256"},
        "snapshotManifestSha256": {"$ref": "#/$defs/sha256"},
        "snapshotSha256": {"$ref": "#/$defs/sha256"},
        "fileTreeSha256": {"$ref": "#/$defs/sha256"},
        "chatTemplateSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approvalId", "actorId", "actorRole", "reference", "approvedAtUtc", "evidenceSha256", "evidenceSizeBytes"],
      "properties": {
        "approvalId": {"$ref": "#/$defs/id"},
        "actorId": {"$ref": "#/$defs/id"},
        "actorRole": {"$ref": "#/$defs/id"},
        "reference": {"type": "string", "minLength": 1, "maxLength": 500},
        "approvedAtUtc": {"$ref": "#/$defs/utc"},
        "evidenceSha256": {"$ref": "#/$defs/sha256"},
        "evidenceSizeBytes": {"type": "integer", "minimum": 1}
      }
    },
    "statement": {"const": "Authenticates the reviewed base-model choice and exact snapshot for training only; it is not a checkpoint, training result, promotion, deployment, or quality claim."}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["releaseId", "releaseSha256", "manifestSha256"],
      "properties": {
        "releaseId": {"type": "string", "pattern": "^vqrel-[0-9a-f]{64}$"},
        "releaseSha256": {"$ref": "#/$defs/sha256"},
        "manifestSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["responseSchemaVersion", "targetKind", "executionModelId", "candidateCatalogSha256", "candidateId", "modelId", "modelRevision", "servingProfile", "runId", "seed"],
      "properties": {
        "responseSchemaVersion": {"type": "string", "minLength": 1},
        "targetKind": {"enum": ["trained-adapter", "raw-base"]},
        "executionModelId": {"$ref": "#/$defs/id"},
        "candidateCatalogSha256": {"$ref": "#/$defs/sha256"},
        "candidateId": {"$ref": "#/$defs/id"},
        "modelId": {"type": "string", "minLength": 1, "maxLength": 500},
        "modelRevision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "servingProfile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "sha256"],
          "properties": {"id": {"$ref": "#/$defs/id"}, "sha256": {"$ref": "#/$defs/sha256"}}
        },
        "runId": {"$ref": "#/$defs/id"},
        "seed": {"type": "integer", "minimum": 0, "maximum": 2147483647}
      }
    },
    "candidateRun": {
      "allOf": [
        {"$ref": "#/$defs/run"},
        {
          "properties": {
            "responseSchemaVersion": {"const": "daxalgo.hyperion.evaluation-response/v2"},
            "targetKind": {"const": "raw-base"}
          }
        }
      ]
    }
  }
}
