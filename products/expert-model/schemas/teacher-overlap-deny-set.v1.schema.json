{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daxalgo.local/schemas/hyperion/teacher-overlap-deny-set.v1.schema.json",
  "title": "Hyperion teacher overlap deny set v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "purpose", "denySetId", "custodian", "createdAtUtc", "scope", "scopeSha256", "entries"],
  "properties": {
    "schemaVersion": {"const": "daxalgo.hyperion.teacher-overlap-deny-set/v1"},
    "purpose": {"const": "held-out-overlap-exclusion"},
    "denySetId": {"$ref": "#/$defs/id"},
    "custodian": {"$ref": "#/$defs/id"},
    "createdAtUtc": {"$ref": "#/$defs/utcSecond"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calibration", "sealed"],
      "properties": {
        "calibration": {"$ref": "#/$defs/scopeArtifact"},
        "sealed": {"$ref": "#/$defs/scopeArtifact"}
      }
    },
    "scopeSha256": {"$ref": "#/$defs/sha256"},
    "entries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authoredMessagesSha256", "normalizedUserTurnSha256", "contaminationGroupSha256", "heldOutAssetSha256"],
      "properties": {
        "authoredMessagesSha256": {"$ref": "#/$defs/sha256Set"},
        "normalizedUserTurnSha256": {"$ref": "#/$defs/sha256Set"},
        "contaminationGroupSha256": {"$ref": "#/$defs/sha256Set"},
        "heldOutAssetSha256": {"$ref": "#/$defs/sha256Set"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"},
    "utcSecond": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "sha256Set": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha256"}
    },
    "scopeArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileSha256", "taskSetSha256", "recordCount"],
      "properties": {
        "fileSha256": {"$ref": "#/$defs/sha256"},
        "taskSetSha256": {"$ref": "#/$defs/sha256"},
        "recordCount": {"type": "integer", "minimum": 1, "maximum": 10000}
      }
    }
  }
}
