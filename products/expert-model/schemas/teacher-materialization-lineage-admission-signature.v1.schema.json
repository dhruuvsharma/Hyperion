{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daxalgo.local/schemas/hyperion/teacher-materialization-lineage-admission-signature.v1.schema.json",
  "title": "DaxAlgo detached teacher materialization lineage admission signature v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "signatureId", "signingBundleId", "signingBundleSha256", "lineageAdmissionId", "payloadSha256", "signatureInputSha256", "publicKeySpkiSha256", "format", "signature"],
  "properties": {
    "schemaVersion": {"const": "daxalgo.hyperion.teacher-materialization-lineage-admission-signature/v1"},
    "signatureId": {"type": "string", "pattern": "^vqtlineagesignature-[0-9a-f]{64}$"},
    "signingBundleId": {"type": "string", "pattern": "^vqtlineagesigning-[0-9a-f]{64}$"},
    "signingBundleSha256": {"$ref": "#/$defs/sha256"},
    "lineageAdmissionId": {"type": "string", "pattern": "^vqtlineage-[0-9a-f]{64}$"},
    "payloadSha256": {"$ref": "#/$defs/sha256"},
    "signatureInputSha256": {"$ref": "#/$defs/sha256"},
    "publicKeySpkiSha256": {"$ref": "#/$defs/sha256"},
    "format": {"enum": ["asn1-der", "ieee-p1363-fixed-64"]},
    "signature": {"type": "string", "minLength": 1, "maxLength": 107, "pattern": "^[A-Za-z0-9_-]+$"}
  },
  "allOf": [
    {
      "if": {"properties": {"format": {"const": "ieee-p1363-fixed-64"}}, "required": ["format"]},
      "then": {"properties": {"signature": {"minLength": 86, "maxLength": 86}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
