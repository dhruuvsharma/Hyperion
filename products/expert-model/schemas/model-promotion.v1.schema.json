{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daxalgo.local/schemas/hyperion/model-promotion.v1.schema.json",
  "title": "Hyperion production model promotion payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "promotionId", "decision", "productionEligible", "issuedAtUtc", "notBeforeUtc", "expiresAtUtc", "dataRelease", "promotionEvidence", "model", "deployment", "approval", "hostedDeploymentPolicy"],
  "properties": {
    "schemaVersion": {"const": "daxalgo.hyperion.model-promotion/v1"},
    "promotionId": {"type": "string", "pattern": "^vqprom-[0-9a-f]{64}$"},
    "decision": {"const": "approved-for-production"},
    "productionEligible": {"const": true},
    "issuedAtUtc": {"$ref": "#/$defs/utcSecond"},
    "notBeforeUtc": {"$ref": "#/$defs/utcSecond"},
    "expiresAtUtc": {"$ref": "#/$defs/utcSecond"},
    "dataRelease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["releaseId", "releaseSha256", "manifestSha256"],
      "properties": {
        "releaseId": {"type": "string", "pattern": "^vqrel-[0-9a-f]{64}$"},
        "releaseSha256": {"$ref": "#/$defs/sha256"},
        "manifestSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "promotionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reportSha256", "reportFileSha256", "policySha256", "policyFileSha256", "calibrationTasksFileSha256", "calibrationTaskSetSha256", "calibrationEvidenceSha256", "sealedTasksFileSha256", "sealedTaskSetSha256", "candidateResponsesFileSha256", "candidateResponseSetSha256", "candidateVerifierResultsFileSha256", "candidateVerifierResultSetSha256", "baselineResponsesFileSha256", "baselineResponseSetSha256", "baselineVerifierResultsFileSha256", "baselineVerifierResultSetSha256"],
      "properties": {
        "reportSha256": {"$ref": "#/$defs/sha256"},
        "reportFileSha256": {"$ref": "#/$defs/sha256"},
        "policySha256": {"$ref": "#/$defs/sha256"},
        "policyFileSha256": {"$ref": "#/$defs/sha256"},
        "calibrationTasksFileSha256": {"$ref": "#/$defs/sha256"},
        "calibrationTaskSetSha256": {"$ref": "#/$defs/sha256"},
        "calibrationEvidenceSha256": {"$ref": "#/$defs/sha256"},
        "sealedTasksFileSha256": {"$ref": "#/$defs/sha256"},
        "sealedTaskSetSha256": {"$ref": "#/$defs/sha256"},
        "candidateResponsesFileSha256": {"$ref": "#/$defs/sha256"},
        "candidateResponseSetSha256": {"$ref": "#/$defs/sha256"},
        "candidateVerifierResultsFileSha256": {"$ref": "#/$defs/sha256"},
        "candidateVerifierResultSetSha256": {"$ref": "#/$defs/sha256"},
        "baselineResponsesFileSha256": {"$ref": "#/$defs/sha256"},
        "baselineResponseSetSha256": {"$ref": "#/$defs/sha256"},
        "baselineVerifierResultsFileSha256": {"$ref": "#/$defs/sha256"},
        "baselineVerifierResultSetSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateCatalogSha256", "candidateId", "modelId", "modelRevision", "trainingRunManifestSha256", "artifactMetadataFileSha256", "artifactSha256", "artifactTreeSha256", "servingProfileId", "servingProfileSha256", "executionModelId", "chatTemplateSha256", "containerImageDigest"],
      "properties": {
        "candidateCatalogSha256": {"$ref": "#/$defs/sha256"},
        "candidateId": {"$ref": "#/$defs/profileId"},
        "modelId": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"},
        "modelRevision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "trainingRunManifestSha256": {"$ref": "#/$defs/sha256"},
        "artifactMetadataFileSha256": {"$ref": "#/$defs/sha256"},
        "artifactSha256": {"$ref": "#/$defs/sha256"},
        "artifactTreeSha256": {"$ref": "#/$defs/sha256"},
        "servingProfileId": {"$ref": "#/$defs/profileId"},
        "servingProfileSha256": {"$ref": "#/$defs/sha256"},
        "executionModelId": {"type": "string", "pattern": "^daxalgo-expert-sha256-[0-9a-f]{64}$"},
        "chatTemplateSha256": {"$ref": "#/$defs/sha256"},
        "containerImageDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deploymentId", "environment", "audience"],
      "properties": {
        "deploymentId": {"$ref": "#/$defs/id"},
        "environment": {"$ref": "#/$defs/id"},
        "audience": {"$ref": "#/$defs/id"}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approvalId", "actorId", "actorRole", "reference", "approvedAtUtc", "evidenceSha256", "evidenceSizeBytes"],
      "properties": {
        "approvalId": {"$ref": "#/$defs/id"},
        "actorId": {"$ref": "#/$defs/id"},
        "actorRole": {"$ref": "#/$defs/id"},
        "reference": {"type": "string", "minLength": 1, "maxLength": 500},
        "approvedAtUtc": {"$ref": "#/$defs/utcSecond"},
        "evidenceSha256": {"$ref": "#/$defs/sha256"},
        "evidenceSizeBytes": {"type": "integer", "minimum": 1, "maximum": 16000000}
      }
    },
    "hostedDeploymentPolicy": {
      "oneOf": [
        {"$ref": "hosted-deployment-policy.v1.schema.json"},
        {"$ref": "hosted-deployment-policy.v2.schema.json"}
      ]
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "profileId": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "utcSecond": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"}
  }
}
