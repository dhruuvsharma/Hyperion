{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daxalgo.local/schemas/vibe-quant/base-model-selection-signing-bundle.v1.schema.json",
  "title": "DaxAlgo non-authorizing base-model selection signing bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "bundleId", "status", "authority", "trust", "selectionId", "dataRelease", "evaluationMatrixId", "candidateCatalogSha256", "sourceLockSha256", "requiredCandidateIds", "selected", "approval", "validity", "signatureContract", "request"],
  "properties": {
    "schemaVersion": {"const": "daxalgo.vibe-quant.base-model-selection-signing-bundle/v1"},
    "bundleId": {"type": "string", "pattern": "^vqbaseselectionsigning-[0-9a-f]{64}$"},
    "status": {"const": "unsigned-non-authorizing"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseModelSelectionIssuance", "corpusReview", "evaluationAuthoring", "release", "training", "checkpoint", "evaluation", "promotionDecision", "deployment", "hostedServing", "installation", "verifierExecution", "strategyExecution"],
      "properties": {
        "baseModelSelectionIssuance": {"const": false},
        "corpusReview": {"const": false},
        "evaluationAuthoring": {"const": false},
        "release": {"const": false},
        "training": {"const": false},
        "checkpoint": {"const": false},
        "evaluation": {"const": false},
        "promotionDecision": {"const": false},
        "deployment": {"const": false},
        "hostedServing": {"const": false},
        "installation": {"const": false},
        "verifierExecution": {"const": false},
        "strategyExecution": {"const": false}
      }
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publicKeySpkiSha256", "audience", "keyId", "signerRole"],
      "properties": {
        "publicKeySpkiSha256": {"$ref": "#/$defs/sha256"},
        "audience": {"$ref": "#/$defs/id"},
        "keyId": {"$ref": "#/$defs/id"},
        "signerRole": {"$ref": "#/$defs/id"}
      }
    },
    "selectionId": {"$ref": "#/$defs/selectionId"},
    "dataRelease": {"$ref": "#/$defs/release"},
    "evaluationMatrixId": {"$ref": "#/$defs/evaluationMatrixId"},
    "candidateCatalogSha256": {"$ref": "#/$defs/sha256"},
    "sourceLockSha256": {"$ref": "#/$defs/sha256"},
    "requiredCandidateIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "selected": {"$ref": "#/$defs/target"},
    "approval": {"$ref": "#/$defs/approval"},
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuedAtUtc", "notBeforeUtc", "expiresAtUtc"],
      "properties": {
        "issuedAtUtc": {"$ref": "#/$defs/utc"},
        "notBeforeUtc": {"$ref": "#/$defs/utc"},
        "expiresAtUtc": {"$ref": "#/$defs/utc"}
      }
    },
    "signatureContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "hashAlgorithm", "messageType", "signatureInputEncoding", "acceptedSignatureFormats"],
      "properties": {
        "algorithm": {"const": "ES256"},
        "hashAlgorithm": {"const": "SHA-256"},
        "messageType": {"const": "digest"},
        "signatureInputEncoding": {"const": "base64url"},
        "acceptedSignatureFormats": {
          "type": "array",
          "prefixItems": [
            {"const": "asn1-der"},
            {"const": "ieee-p1363-fixed-64"}
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selectionId", "payloadSha256", "payload", "signatureInputSha256", "signaturePreimage", "signatureInput"],
      "properties": {
        "selectionId": {"$ref": "#/$defs/selectionId"},
        "payloadSha256": {"$ref": "#/$defs/sha256"},
        "payload": {"allOf": [{"$ref": "#/$defs/base64url"}, {"maxLength": 1000000}]},
        "signatureInputSha256": {"$ref": "#/$defs/sha256"},
        "signaturePreimage": {"allOf": [{"$ref": "#/$defs/base64url"}, {"maxLength": 2000000}]},
        "signatureInput": {"type": "string", "minLength": 43, "maxLength": 43, "pattern": "^[A-Za-z0-9_-]{43}$"}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"},
    "modelId": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,499}$"},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "base64url": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_-]+$"},
    "selectionId": {"type": "string", "pattern": "^vqbaseselect-[0-9a-f]{64}$"},
    "evaluationMatrixId": {"type": "string", "pattern": "^vqbasebakeoff-[0-9a-f]{64}$"},
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["releaseId", "releaseSha256", "manifestSha256"],
      "properties": {
        "releaseId": {"type": "string", "pattern": "^vqrel-[0-9a-f]{64}$"},
        "releaseSha256": {"$ref": "#/$defs/sha256"},
        "manifestSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateCatalogSha256", "candidateId", "modelId", "modelRevision", "profileId", "profileSha256", "executionModelId", "sourceLockSha256", "snapshotManifestSha256", "snapshotSha256", "fileTreeSha256", "chatTemplateSha256"],
      "properties": {
        "candidateCatalogSha256": {"$ref": "#/$defs/sha256"},
        "candidateId": {"$ref": "#/$defs/id"},
        "modelId": {"$ref": "#/$defs/modelId"},
        "modelRevision": {"$ref": "#/$defs/revision"},
        "profileId": {"$ref": "#/$defs/id"},
        "profileSha256": {"$ref": "#/$defs/sha256"},
        "executionModelId": {"$ref": "#/$defs/id"},
        "sourceLockSha256": {"$ref": "#/$defs/sha256"},
        "snapshotManifestSha256": {"$ref": "#/$defs/sha256"},
        "snapshotSha256": {"$ref": "#/$defs/sha256"},
        "fileTreeSha256": {"$ref": "#/$defs/sha256"},
        "chatTemplateSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approvalId", "actorId", "actorRole", "reference", "approvedAtUtc", "evidenceSha256", "evidenceSizeBytes"],
      "properties": {
        "approvalId": {"$ref": "#/$defs/id"},
        "actorId": {"$ref": "#/$defs/id"},
        "actorRole": {"$ref": "#/$defs/id"},
        "reference": {"type": "string", "minLength": 1, "maxLength": 500},
        "approvedAtUtc": {"$ref": "#/$defs/utc"},
        "evidenceSha256": {"$ref": "#/$defs/sha256"},
        "evidenceSizeBytes": {"type": "integer", "minimum": 1, "maximum": 16000000}
      }
    }
  }
}
