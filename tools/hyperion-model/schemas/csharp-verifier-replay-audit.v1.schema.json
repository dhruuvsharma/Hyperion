{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daxalgo.local/schemas/vibe-quant/csharp-verifier-replay-audit.v1.schema.json",
  "title": "Vibe Quant signed offline C# verifier replay audit v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "auditId", "decision", "scope", "reusable", "reviewAuthorized", "releaseAuthorized", "trainingAuthorized", "baseSelectionAuthorized", "promotionDecisionAuthorized", "deploymentAuthorized", "hostedServingAuthorized", "installationAuthorized", "issuedAtUtc", "notBeforeUtc", "expiresAtUtc", "replayCompletedAtUtc", "dataRelease", "sealedTasksFileSha256", "sealedTaskSetSha256", "csharpVerifierConfigurationSha256", "csharpTaskBindings", "candidate", "baseline", "approval", "statement"],
  "properties": {
    "schemaVersion": {"const": "daxalgo.vibe-quant.csharp-verifier-replay-audit/v1"},
    "auditId": {"type": "string", "pattern": "^daxalgo-csharp-verifier-replay-audit-sha256-[0-9a-f]{64}$"},
    "decision": {"const": "verified"},
    "scope": {"const": "trained-adapter-promotion-replay-only"},
    "reusable": {"const": true},
    "reviewAuthorized": {"const": false},
    "releaseAuthorized": {"const": false},
    "trainingAuthorized": {"const": false},
    "baseSelectionAuthorized": {"const": false},
    "promotionDecisionAuthorized": {"const": false},
    "deploymentAuthorized": {"const": false},
    "hostedServingAuthorized": {"const": false},
    "installationAuthorized": {"const": false},
    "issuedAtUtc": {"$ref": "#/$defs/utc"},
    "notBeforeUtc": {"$ref": "#/$defs/utc"},
    "expiresAtUtc": {"$ref": "#/$defs/utc"},
    "replayCompletedAtUtc": {"$ref": "#/$defs/utc"},
    "dataRelease": {"$ref": "#/$defs/releaseIdentity"},
    "sealedTasksFileSha256": {"$ref": "#/$defs/sha256"},
    "sealedTaskSetSha256": {"$ref": "#/$defs/sha256"},
    "csharpVerifierConfigurationSha256": {"$ref": "#/$defs/sha256"},
    "csharpTaskBindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {"$ref": "#/$defs/taskBinding"}
    },
    "candidate": {"$ref": "#/$defs/run"},
    "baseline": {"$ref": "#/$defs/run"},
    "approval": {"$ref": "#/$defs/approval"},
    "statement": {"type": "string", "minLength": 1, "maxLength": 1000}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "utc": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "releaseIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["releaseId", "releaseSha256", "manifestSha256"],
      "properties": {
        "releaseId": {"type": "string", "pattern": "^vqrel-[0-9a-f]{64}$"},
        "releaseSha256": {"$ref": "#/$defs/sha256"},
        "manifestSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "servingProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "runIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["responseSchemaVersion", "targetKind", "executionModelId", "candidateCatalogSha256", "candidateId", "modelId", "modelRevision", "servingProfile", "runId", "seed"],
      "properties": {
        "responseSchemaVersion": {"enum": ["daxalgo.vibe-quant.evaluation-response/v1", "daxalgo.vibe-quant.evaluation-response/v2"]},
        "targetKind": {"enum": ["trained-adapter", "raw-base"]},
        "executionModelId": {"type": "string", "pattern": "^daxalgo-(expert|base)-sha256-[0-9a-f]{64}$"},
        "candidateCatalogSha256": {"$ref": "#/$defs/sha256"},
        "candidateId": {"$ref": "#/$defs/id"},
        "modelId": {"type": "string", "minLength": 1, "maxLength": 200},
        "modelRevision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "servingProfile": {"$ref": "#/$defs/servingProfile"},
        "runId": {"$ref": "#/$defs/id"},
        "seed": {"type": "integer", "minimum": 0, "maximum": 2147483647}
      }
    },
    "taskBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "taskSha256", "verifierId", "verifierSha256"],
      "properties": {
        "taskId": {"$ref": "#/$defs/id"},
        "taskSha256": {"$ref": "#/$defs/sha256"},
        "verifierId": {"$ref": "#/$defs/id"},
        "verifierSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "taskEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "responseSha256", "resultSha256"],
      "properties": {
        "taskId": {"$ref": "#/$defs/id"},
        "responseSha256": {"$ref": "#/$defs/sha256"},
        "resultSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "responsesFileSha256", "responseSetSha256", "verifierResultsFileSha256", "verifierResultSetSha256", "csharpTasks"],
      "properties": {
        "identity": {"$ref": "#/$defs/runIdentity"},
        "responsesFileSha256": {"$ref": "#/$defs/sha256"},
        "responseSetSha256": {"$ref": "#/$defs/sha256"},
        "verifierResultsFileSha256": {"$ref": "#/$defs/sha256"},
        "verifierResultSetSha256": {"$ref": "#/$defs/sha256"},
        "csharpTasks": {"type": "array", "minItems": 1, "maxItems": 100000, "items": {"$ref": "#/$defs/taskEvidence"}}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approvalId", "actorId", "actorRole", "reference", "approvedAtUtc"],
      "properties": {
        "approvalId": {"$ref": "#/$defs/id"},
        "actorId": {"$ref": "#/$defs/id"},
        "actorRole": {"$ref": "#/$defs/id"},
        "reference": {"type": "string", "minLength": 1, "maxLength": 500},
        "approvedAtUtc": {"$ref": "#/$defs/utc"}
      }
    }
  }
}
