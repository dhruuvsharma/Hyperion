{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daxalgo.local/schemas/vibe-quant/training-corpus-admission.v1.schema.json",
  "title": "Vibe Quant training corpus admission v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "corpusAdmissionId",
    "scope",
    "decision",
    "reusable",
    "corpusAdmissionAuthorized",
    "rightsAuthorized",
    "reviewReceiptAuthorized",
    "releaseAuthorized",
    "trainingAuthorized",
    "evaluationAuthorized",
    "promotionDecisionAuthorized",
    "deploymentAuthorized",
    "hostedServingAuthorized",
    "installationAuthorized",
    "verifierExecutionAuthorized",
    "strategyExecutionAuthorized",
    "reviewedAtUtc",
    "issuedAtUtc",
    "notBeforeUtc",
    "expiresAtUtc",
    "reviewerId",
    "dataRelease",
    "dataset",
    "qualityReport",
    "qualityReportSha256",
    "qualityPolicy",
    "qualityPolicySha256",
    "statement"
  ],
  "properties": {
    "schemaVersion": {"const": "daxalgo.vibe-quant.training-corpus-admission/v1"},
    "corpusAdmissionId": {"type": "string", "pattern": "^vqcorpusadmit-[0-9a-f]{64}$"},
    "scope": {"const": "exact-released-training-corpus-admission-only"},
    "decision": {"const": "admitted"},
    "reusable": {"const": true},
    "corpusAdmissionAuthorized": {"const": true},
    "rightsAuthorized": {"const": false},
    "reviewReceiptAuthorized": {"const": false},
    "releaseAuthorized": {"const": false},
    "trainingAuthorized": {"const": false},
    "evaluationAuthorized": {"const": false},
    "promotionDecisionAuthorized": {"const": false},
    "deploymentAuthorized": {"const": false},
    "hostedServingAuthorized": {"const": false},
    "installationAuthorized": {"const": false},
    "verifierExecutionAuthorized": {"const": false},
    "strategyExecutionAuthorized": {"const": false},
    "reviewedAtUtc": {"$ref": "#/$defs/utc"},
    "issuedAtUtc": {"$ref": "#/$defs/utc"},
    "notBeforeUtc": {"$ref": "#/$defs/utc"},
    "expiresAtUtc": {"$ref": "#/$defs/utc"},
    "reviewerId": {"$ref": "#/$defs/id"},
    "dataRelease": {"$ref": "#/$defs/releaseIdentity"},
    "dataset": {"$ref": "training-corpus-quality-report.v1.schema.json#/$defs/dataset"},
    "qualityReport": {"$ref": "training-corpus-quality-report.v1.schema.json"},
    "qualityReportSha256": {"$ref": "#/$defs/sha256"},
    "qualityPolicy": {"$ref": "training-corpus-quality-policy.v1.schema.json"},
    "qualityPolicySha256": {"$ref": "#/$defs/sha256"},
    "statement": {"const": "This signed decision authorizes only the reviewer-selected corpus quality floor for the exact released dataset and report. It does not establish rights, review-receipt validity, release, training execution, evaluation, promotion, deployment, hosted serving, installation, verifier execution, or strategy execution authority."}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "utc": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "releaseIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["releaseId", "releaseSha256", "manifestSha256"],
      "properties": {
        "releaseId": {"type": "string", "pattern": "^vqrel-[0-9a-f]{64}$"},
        "releaseSha256": {"$ref": "#/$defs/sha256"},
        "manifestSha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
