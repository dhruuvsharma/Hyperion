{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daxalgo.local/schemas/vibe-quant/executable-verifier.v2.schema.json",
  "title": "Vibe Quant signed headless C# executable verifier v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "verifierId", "taskId", "profile", "contract", "cases"],
  "properties": {
    "schemaVersion": {"const": "daxalgo.vibe-quant.executable-verifier/v2"},
    "verifierId": {"$ref": "#/$defs/id"},
    "taskId": {"$ref": "#/$defs/id"},
    "profile": {"const": "daxalgo-sdk-headless-source/v1"},
    "contract": {"$ref": "#/$defs/contract"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "secType", "exchange", "currency", "primaryExchange"],
      "properties": {
        "symbol": {"$ref": "#/$defs/text"},
        "secType": {"type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"},
        "exchange": {"$ref": "#/$defs/text"},
        "currency": {"type": "string", "minLength": 1, "maxLength": 16, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"},
        "primaryExchange": {"$ref": "#/$defs/text"}
      }
    },
    "tick": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offsetMilliseconds", "bid", "ask", "bidSize", "askSize"],
      "properties": {
        "offsetMilliseconds": {"type": "integer", "minimum": 0, "maximum": 604800000},
        "bid": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000000000000},
        "ask": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000000000000},
        "bidSize": {"type": "integer", "minimum": 0, "maximum": 1000000000000},
        "askSize": {"type": "integer", "minimum": 0, "maximum": 1000000000000}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "startUtc", "ticks", "expectedTraceSha256"],
      "properties": {
        "caseId": {"$ref": "#/$defs/id"},
        "startUtc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,7})?Z$"
        },
        "ticks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2048,
          "items": {"$ref": "#/$defs/tick"}
        },
        "expectedTraceSha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
