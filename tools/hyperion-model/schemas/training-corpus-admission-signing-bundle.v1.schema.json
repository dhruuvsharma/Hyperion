{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daxalgo.local/schemas/vibe-quant/training-corpus-admission-signing-bundle.v1.schema.json",
  "title": "DaxAlgo non-authorizing training corpus admission signing bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "bundleId", "status", "authority", "trust", "corpusAdmissionId", "dataRelease", "datasetSha256", "qualityReportSha256", "qualityPolicySha256", "signatureContract", "request"],
  "properties": {
    "schemaVersion": {"const": "daxalgo.vibe-quant.training-corpus-admission-signing-bundle/v1"},
    "bundleId": {"type": "string", "pattern": "^vqcorpusadmissionsigning-[0-9a-f]{64}$"},
    "status": {"const": "unsigned-non-authorizing"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["corpusAdmissionIssuance", "rights", "reviewReceipt", "release", "training", "evaluation", "promotionDecision", "deployment", "hostedServing", "installation", "verifierExecution", "strategyExecution"],
      "properties": {
        "corpusAdmissionIssuance": {"const": false},
        "rights": {"const": false},
        "reviewReceipt": {"const": false},
        "release": {"const": false},
        "training": {"const": false},
        "evaluation": {"const": false},
        "promotionDecision": {"const": false},
        "deployment": {"const": false},
        "hostedServing": {"const": false},
        "installation": {"const": false},
        "verifierExecution": {"const": false},
        "strategyExecution": {"const": false}
      }
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publicKeySpkiSha256", "audience", "keyId", "signerRole", "qualityPolicySha256"],
      "properties": {
        "publicKeySpkiSha256": {"$ref": "#/$defs/sha256"},
        "audience": {"$ref": "#/$defs/id"},
        "keyId": {"$ref": "#/$defs/id"},
        "signerRole": {"$ref": "#/$defs/id"},
        "qualityPolicySha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "corpusAdmissionId": {"$ref": "#/$defs/corpusAdmissionId"},
    "dataRelease": {"$ref": "#/$defs/releaseIdentity"},
    "datasetSha256": {"$ref": "#/$defs/sha256"},
    "qualityReportSha256": {"$ref": "#/$defs/sha256"},
    "qualityPolicySha256": {"$ref": "#/$defs/sha256"},
    "signatureContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "hashAlgorithm", "messageType", "signatureInputEncoding", "acceptedSignatureFormats"],
      "properties": {
        "algorithm": {"const": "ES256"},
        "hashAlgorithm": {"const": "SHA-256"},
        "messageType": {"const": "digest"},
        "signatureInputEncoding": {"const": "base64url"},
        "acceptedSignatureFormats": {
          "type": "array",
          "prefixItems": [
            {"const": "asn1-der"},
            {"const": "ieee-p1363-fixed-64"}
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["corpusAdmissionId", "payloadSha256", "payload", "signatureInputSha256", "signaturePreimage", "signatureInput"],
      "properties": {
        "corpusAdmissionId": {"$ref": "#/$defs/corpusAdmissionId"},
        "payloadSha256": {"$ref": "#/$defs/sha256"},
        "payload": {"allOf": [{"$ref": "#/$defs/base64url"}, {"maxLength": 1000000}]},
        "signatureInputSha256": {"$ref": "#/$defs/sha256"},
        "signaturePreimage": {"allOf": [{"$ref": "#/$defs/base64url"}, {"maxLength": 2000000}]},
        "signatureInput": {"type": "string", "minLength": 43, "maxLength": 43, "pattern": "^[A-Za-z0-9_-]{43}$"}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "base64url": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_-]+$"},
    "corpusAdmissionId": {"type": "string", "pattern": "^vqcorpusadmit-[0-9a-f]{64}$"},
    "releaseIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["releaseId", "releaseSha256", "manifestSha256"],
      "properties": {
        "releaseId": {"type": "string", "pattern": "^vqrel-[0-9a-f]{64}$"},
        "releaseSha256": {"$ref": "#/$defs/sha256"},
        "manifestSha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
