{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daxalgo.local/schemas/vibe-quant/base-attested-completion-request.v1.schema.json",
  "title": "Vibe Quant atomic attested raw-base completion request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "nonce", "evaluation", "request"],
  "properties": {
    "schemaVersion": {"const": "daxalgo.vibe-quant.base-attested-completion-request/v1"},
    "nonce": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
    "evaluation": {"$ref": "#/$defs/evaluation"},
    "request": {"$ref": "#/$defs/request"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "taskId", "taskSha256", "promptSha256", "dataRelease"],
      "properties": {
        "runId": {"$ref": "#/$defs/id"},
        "taskId": {"$ref": "#/$defs/id"},
        "taskSha256": {"$ref": "#/$defs/sha256"},
        "promptSha256": {"$ref": "#/$defs/sha256"},
        "dataRelease": {
          "type": "object",
          "additionalProperties": false,
          "required": ["releaseId", "releaseSha256", "manifestSha256"],
          "properties": {
            "releaseId": {"type": "string", "pattern": "^vqrel-[0-9a-f]{64}$"},
            "releaseSha256": {"$ref": "#/$defs/sha256"},
            "manifestSha256": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "content"],
      "properties": {
        "role": {"enum": ["system", "user", "assistant"]},
        "content": {"type": "string", "minLength": 1, "maxLength": 1000000}
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "messages", "temperature", "top_p", "seed", "max_tokens", "n"],
      "properties": {
        "model": {"$ref": "#/$defs/id"},
        "messages": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/message"}},
        "temperature": {"const": 0},
        "top_p": {"const": 1},
        "seed": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "max_tokens": {"type": "integer", "minimum": 1, "maximum": 262144},
        "n": {"const": 1}
      }
    }
  }
}
