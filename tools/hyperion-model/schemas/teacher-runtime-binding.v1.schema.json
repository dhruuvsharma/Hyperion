{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daxalgo.local/schemas/vibe-quant/teacher-runtime-binding.v1.schema.json",
  "title": "Vibe Quant teacher runtime binding v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "bindingSha256", "evidenceStatus", "candidateCatalog", "runtimeDescriptor", "chatTemplate", "teacher", "runtime", "endpoint", "tokenizerPreflight"],
  "properties": {
    "schemaVersion": {"const": "daxalgo.vibe-quant.teacher-runtime-binding/v1"},
    "bindingSha256": {"$ref": "#/$defs/sha256"},
    "evidenceStatus": {"const": "unattested-observation"},
    "candidateCatalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 2000},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "runtimeDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contentPath", "sha256", "sizeBytes"],
      "properties": {
        "contentPath": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "sizeBytes": {"type": "integer", "minimum": 1, "maximum": 1000000}
      }
    },
    "chatTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contentPath", "sha256", "sizeBytes"],
      "properties": {
        "contentPath": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "sizeBytes": {"type": "integer", "minimum": 1, "maximum": 1000000}
      }
    },
    "teacher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateCatalogSha256", "candidateId", "modelId", "modelRevision", "profileVersion", "chatTemplateSha256", "runtimeSha256", "executionModelId"],
      "properties": {
        "candidateCatalogSha256": {"$ref": "#/$defs/sha256"},
        "candidateId": {"$ref": "#/$defs/id"},
        "modelId": {"type": "string", "minLength": 1, "maxLength": 500},
        "modelRevision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "profileVersion": {"type": "string", "minLength": 1, "maxLength": 500},
        "chatTemplateSha256": {"$ref": "#/$defs/sha256"},
        "runtimeSha256": {"$ref": "#/$defs/sha256"},
        "executionModelId": {"type": "string", "pattern": "^daxalgo-teacher-sha256-[0-9a-f]{64}$"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "engineVersion", "modelRoot", "maxModelLen"],
      "properties": {
        "engine": {"const": "vllm"},
        "engineVersion": {"enum": ["0.10.0", "0.26.0"]},
        "modelRoot": {"type": "string", "minLength": 1, "maxLength": 2000},
        "maxModelLen": {"type": "integer", "minimum": 1, "maximum": 1048576}
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseUrl"],
      "properties": {
        "baseUrl": {"type": "string", "pattern": "^http://127\\.0\\.0\\.1:(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])/v1$"}
      }
    },
    "tokenizerPreflight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "maxModelLen"],
      "properties": {
        "protocol": {"const": "vllm-tokenize-chat/v1"},
        "maxModelLen": {"type": "integer", "minimum": 1, "maximum": 1048576}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"},
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*//)(?!.*\\/$)(?!\\.\\.?$)(?!\\.\\.?/)(?!.*\\/\\.\\.?(?:\\/|$)).+$"
    }
  }
}
