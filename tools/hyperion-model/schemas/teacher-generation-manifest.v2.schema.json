{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daxalgo.local/schemas/vibe-quant/teacher-generation-manifest.v2.schema.json",
  "title": "Vibe Quant teacher generation manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "draftManifestSha256", "candidateCatalogSha256", "split", "teacher", "generation", "budget", "authority", "tokenizerPreflight", "tasks"],
  "properties": {
    "schemaVersion": {"const": "daxalgo.vibe-quant.teacher-generation-manifest/v2"},
    "draftManifestSha256": {"$ref": "#/$defs/sha256"},
    "candidateCatalogSha256": {"$ref": "#/$defs/sha256"},
    "split": {"const": "development"},
    "teacher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateId", "profileVersion", "chatTemplateSha256", "runtimeSha256"],
      "properties": {
        "candidateId": {"$ref": "#/$defs/id"},
        "profileVersion": {"type": "string", "minLength": 1, "maxLength": 500},
        "chatTemplateSha256": {"$ref": "#/$defs/sha256"},
        "runtimeSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "generation": {"$ref": "#/$defs/generationPolicy"},
    "budget": {"$ref": "#/$defs/budget"},
    "authority": {"$ref": "#/$defs/authority"},
    "tokenizerPreflight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "maxModelLen"],
      "properties": {
        "protocol": {"const": "vllm-tokenize-chat/v1"},
        "maxModelLen": {"type": "integer", "minimum": 1, "maximum": 1048576}
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["taskId", "taskKind", "domains", "messages", "contaminationGroup", "knowledgeClass", "cutoffUtc", "maxOutputTokens", "evidence", "sources"],
        "properties": {
          "taskId": {"$ref": "#/$defs/id"},
          "taskKind": {"$ref": "#/$defs/taskKind"},
          "domains": {"$ref": "#/$defs/domains"},
          "messages": {"$ref": "#/$defs/messages"},
          "contaminationGroup": {"$ref": "#/$defs/id"},
          "knowledgeClass": {"enum": ["candidate-stable", "retrieval-only"]},
          "cutoffUtc": {"$ref": "#/$defs/utcSecond"},
          "maxOutputTokens": {"type": "integer", "minimum": 1, "maximum": 262144},
          "evidence": {"$ref": "#/$defs/evidence"},
          "sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {"$ref": "#/$defs/source"}
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"},
    "utcSecond": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "taskKind": {
      "enum": ["ArchitectureDesign", "CodeGeneration", "CodeRepair", "CodeReview", "GeneralQuestionAnswering", "MarketAnalysis", "PortfolioAnalysis", "QuantitativeReasoning", "RiskAnalysis", "StatisticalReasoning", "WpfUiDesign"]
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"enum": ["CSharp", "DaxAlgoArchitecture", "QuantitativeMath", "ProbabilityStatistics", "RiskManagement", "PortfolioManagement", "FinanceMarkets", "WpfUiDesign"]}
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "content"],
        "properties": {
          "role": {"enum": ["system", "user", "assistant"]},
          "content": {"type": "string", "minLength": 1, "maxLength": 500000}
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 2000}
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "contentPath", "contentSha256", "provenance", "license", "retrievedAtUtc", "availableAtUtc", "uri"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title": {"type": "string", "minLength": 1, "maxLength": 500},
        "contentPath": {"type": "string", "minLength": 1, "maxLength": 500},
        "contentSha256": {"$ref": "#/$defs/sha256"},
        "provenance": {"type": "string", "minLength": 1, "maxLength": 2000},
        "license": {"type": "string", "minLength": 1, "maxLength": 500},
        "retrievedAtUtc": {"$ref": "#/$defs/utcSecond"},
        "availableAtUtc": {"$ref": "#/$defs/utcSecond"},
        "uri": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "format": "uri", "maxLength": 2000}
          ]
        }
      }
    },
    "generationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["temperature", "topP", "seeds"],
      "properties": {
        "temperature": {"type": "number", "exclusiveMinimum": 0, "maximum": 2},
        "topP": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "seeds": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0, "maximum": 2147483647}
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxRequests", "maxPromptTokens", "maxCompletionTokens", "maxTotalTokens"],
      "properties": {
        "maxRequests": {"type": "integer", "minimum": 1, "maximum": 100000},
        "maxPromptTokens": {"type": "integer", "minimum": 1, "maximum": 200000000},
        "maxCompletionTokens": {"type": "integer", "minimum": 1, "maximum": 200000000},
        "maxTotalTokens": {"type": "integer", "minimum": 1, "maximum": 200000000}
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mayStore", "mayEvaluate", "mayTrain", "mayUploadToProvider", "mayRedistribute"],
      "properties": {
        "mayStore": {"const": true},
        "mayEvaluate": {"const": true},
        "mayTrain": {"const": false},
        "mayUploadToProvider": {"const": false},
        "mayRedistribute": {"const": false}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer", "reviewer", "provenance", "license", "rightsBasis", "rights"],
      "properties": {
        "producer": {"$ref": "#/$defs/id"},
        "reviewer": {"$ref": "#/$defs/id"},
        "provenance": {"type": "string", "minLength": 1, "maxLength": 2000},
        "license": {"type": "string", "minLength": 1, "maxLength": 500},
        "rightsBasis": {"type": "string", "minLength": 1, "maxLength": 2000},
        "rights": {"$ref": "#/$defs/rights"}
      }
    }
  }
}
