{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daxalgo.local/schemas/vibe-quant/expert-model-independent-review-package.v1.schema.json",
  "title": "DaxAlgo non-authorizing independent expert-model review package v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packageId", "status", "authority", "draftDatasetSha256", "reviewedDatasetSha256", "files", "rows", "sources", "decisionTemplate"],
  "properties": {
    "schemaVersion": {"const": "daxalgo.expert-model-independent-review-package/v1"},
    "packageId": {"type": "string", "pattern": "^review-package-[0-9a-f]{64}$"},
    "status": {"const": "unreviewed-handoff"},
    "authority": {"$ref": "#/$defs/noDownstreamAuthority"},
    "draftDatasetSha256": {"$ref": "#/$defs/sha256"},
    "reviewedDatasetSha256": {"$ref": "#/$defs/sha256"},
    "files": {
      "type": "array",
      "minItems": 5,
      "maxItems": 37,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/packageFile"},
      "allOf": [
        {"contains": {"required": ["id"], "properties": {"id": {"const": "draft-dataset"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"required": ["id"], "properties": {"id": {"const": "reviewed-dataset"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"required": ["id"], "properties": {"id": {"const": "verification-manifest"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"required": ["id"], "properties": {"id": {"const": "verification-report"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"required": ["id"], "properties": {"id": {"const": "review-manifest"}}}, "minContains": 1, "maxContains": 1}
      ]
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/rowInventory"}
    },
    "sources": {
      "type": "array",
      "maxItems": 6400000,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sourceInventory"}
    },
    "decisionTemplate": {
      "allOf": [
        {"$ref": "#/$defs/decisionTemplate"},
        {
          "properties": {
            "reviewer": {"const": ""},
            "reviewBasis": {"const": ""},
            "reviewedAtUtc": {"type": "null"},
            "rows": {"items": {"$ref": "#/$defs/denyRowDecision"}},
            "sources": {"items": {"$ref": "#/$defs/denySourceDecision"}}
          }
        }
      ]
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "base64": {"type": "string", "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"},
    "reviewedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\+00:00$"
    },
    "noDownstreamAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receiptAuthority", "trainingEligibilityAuthority", "providerUploadAuthority", "sftExportAuthority", "signingKeyAuthority", "modelReleaseAuthority", "evaluationAuthority", "promotionAuthority", "deploymentAuthority", "executionAuthority"],
      "properties": {
        "receiptAuthority": {"const": false},
        "trainingEligibilityAuthority": {"const": false},
        "providerUploadAuthority": {"const": false},
        "sftExportAuthority": {"const": false},
        "signingKeyAuthority": {"const": false},
        "modelReleaseAuthority": {"const": false},
        "evaluationAuthority": {"const": false},
        "promotionAuthority": {"const": false},
        "deploymentAuthority": {"const": false},
        "executionAuthority": {"const": false}
      }
    },
    "packageFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "purpose", "sizeBytes", "sha256", "contentBase64"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "path": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*(?:/[A-Za-z0-9][A-Za-z0-9._:-]*)*$"},
        "purpose": {"type": "string", "minLength": 1},
        "sizeBytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"},
        "contentBase64": {"$ref": "#/$defs/base64"}
      },
      "oneOf": [
        {
          "properties": {
            "id": {"const": "draft-dataset"},
            "path": {"const": "inputs/draft-dataset.jsonl"},
            "purpose": {"const": "review-input-draft-dataset"},
            "sizeBytes": {"minimum": 1, "maximum": 100000000},
            "contentBase64": {"maxLength": 133333336}
          }
        },
        {
          "properties": {
            "id": {"const": "reviewed-dataset"},
            "path": {"const": "inputs/reviewed-dataset.jsonl"},
            "purpose": {"const": "review-input-reviewed-dataset"},
            "sizeBytes": {"minimum": 1, "maximum": 100000000},
            "contentBase64": {"maxLength": 133333336}
          }
        },
        {
          "properties": {
            "id": {"const": "verification-manifest"},
            "path": {"const": "inputs/verification-manifest.json"},
            "purpose": {"const": "review-input-verification-manifest"},
            "sizeBytes": {"minimum": 1, "maximum": 5000000},
            "contentBase64": {"maxLength": 6666668}
          }
        },
        {
          "properties": {
            "id": {"const": "verification-report"},
            "path": {"const": "inputs/verification-report.json"},
            "purpose": {"const": "review-input-verification-report"},
            "sizeBytes": {"minimum": 1, "maximum": 5000000},
            "contentBase64": {"maxLength": 6666668}
          }
        },
        {
          "properties": {
            "id": {"const": "review-manifest"},
            "path": {"const": "inputs/review-manifest.json"},
            "purpose": {"const": "review-input-review-manifest"},
            "sizeBytes": {"minimum": 1, "maximum": 5000000},
            "contentBase64": {"maxLength": 6666668}
          }
        },
        {
          "properties": {
            "id": {"type": "string", "pattern": "^evidence:[A-Za-z0-9][A-Za-z0-9._:-]{0,190}$"},
            "path": {"type": "string", "pattern": "^evidence/[A-Za-z0-9][A-Za-z0-9._:-]{0,190}\\.bin$"},
            "purpose": {"const": "independent-review-input-evidence"},
            "sizeBytes": {"minimum": 1, "maximum": 10000000},
            "contentBase64": {"maxLength": 13333336}
          }
        }
      ]
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mayStore", "mayEvaluate", "mayTrain", "mayUploadToProvider", "mayRedistribute"],
      "properties": {
        "mayStore": {"const": true},
        "mayEvaluate": {"const": true},
        "mayTrain": {"type": "boolean"},
        "mayUploadToProvider": {"type": "boolean"},
        "mayRedistribute": {"type": "boolean"}
      }
    },
    "decisionRights": {
      "allOf": [
        {"$ref": "#/$defs/rights"},
        {
          "if": {"properties": {"mayUploadToProvider": {"const": true}}, "required": ["mayUploadToProvider"]},
          "then": {"properties": {"mayTrain": {"const": true}}}
        }
      ]
    },
    "denyRights": {
      "allOf": [
        {"$ref": "#/$defs/rights"},
        {"properties": {"mayTrain": {"const": false}, "mayUploadToProvider": {"const": false}, "mayRedistribute": {"const": false}}}
      ]
    },
    "rowInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exampleId", "draftRowSha256", "reviewedRowSha256", "conversationSha256", "reviewStatus", "verified", "split", "knowledgeClass", "currentRights", "useForTraining", "verificationEvidenceSha256", "verificationEvidenceIdentities"],
      "properties": {
        "exampleId": {"$ref": "#/$defs/id"},
        "draftRowSha256": {"$ref": "#/$defs/sha256"},
        "reviewedRowSha256": {"$ref": "#/$defs/sha256"},
        "conversationSha256": {"$ref": "#/$defs/sha256"},
        "reviewStatus": {"enum": ["approved", "rejected"]},
        "verified": {"type": "boolean"},
        "split": {"enum": ["development", "calibration", "sealed"]},
        "knowledgeClass": {"enum": ["candidate-stable", "retrieval-only", "unspecified"]},
        "currentRights": {"$ref": "#/$defs/rights"},
        "useForTraining": {"const": false},
        "verificationEvidenceSha256": {"$ref": "#/$defs/sha256"},
        "verificationEvidenceIdentities": {
          "type": "array",
          "maxItems": 384,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^(?:evidence|compile|test):[0-9]+:[0-9a-f]{64}$"}
        }
      },
      "allOf": [
        {"if": {"properties": {"reviewStatus": {"const": "approved"}}, "required": ["reviewStatus"]}, "then": {"properties": {"verified": {"const": true}}}},
        {"if": {"properties": {"reviewStatus": {"const": "rejected"}}, "required": ["reviewStatus"]}, "then": {"properties": {"verified": {"const": false}}}},
        {"if": {"properties": {"knowledgeClass": {"const": "retrieval-only"}}, "required": ["knowledgeClass"]}, "then": {"properties": {"currentRights": {"properties": {"mayTrain": {"const": false}}}}}}
      ]
    },
    "sourceInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exampleId", "sourceId", "draftSourceSha256", "reviewedSourceSha256", "contentSha256", "currentRights"],
      "properties": {
        "exampleId": {"$ref": "#/$defs/id"},
        "sourceId": {"$ref": "#/$defs/id"},
        "draftSourceSha256": {"$ref": "#/$defs/sha256"},
        "reviewedSourceSha256": {"$ref": "#/$defs/sha256"},
        "contentSha256": {"$ref": "#/$defs/sha256"},
        "currentRights": {"$ref": "#/$defs/rights"}
      }
    },
    "rowDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exampleId", "rights", "useForTraining", "evidenceIds"],
      "properties": {
        "exampleId": {"$ref": "#/$defs/id"},
        "rights": {"$ref": "#/$defs/decisionRights"},
        "useForTraining": {"type": "boolean"},
        "evidenceIds": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        }
      },
      "allOf": [
        {"if": {"properties": {"useForTraining": {"const": true}}, "required": ["useForTraining"]}, "then": {"properties": {"rights": {"properties": {"mayTrain": {"const": true}}}}}}
      ]
    },
    "sourceDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exampleId", "sourceId", "rights", "evidenceIds"],
      "properties": {
        "exampleId": {"$ref": "#/$defs/id"},
        "sourceId": {"$ref": "#/$defs/id"},
        "rights": {"$ref": "#/$defs/decisionRights"},
        "evidenceIds": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        }
      }
    },
    "denyRowDecision": {
      "allOf": [
        {"$ref": "#/$defs/rowDecision"},
        {"properties": {"rights": {"$ref": "#/$defs/denyRights"}, "useForTraining": {"const": false}, "evidenceIds": {"maxItems": 0}}}
      ]
    },
    "denySourceDecision": {
      "allOf": [
        {"$ref": "#/$defs/sourceDecision"},
        {"properties": {"rights": {"$ref": "#/$defs/denyRights"}, "evidenceIds": {"maxItems": 0}}}
      ]
    },
    "decisionTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer", "reviewBasis", "reviewedAtUtc", "rows", "sources"],
      "properties": {
        "reviewer": {"type": "string", "maxLength": 200},
        "reviewBasis": {"type": "string", "maxLength": 4000},
        "reviewedAtUtc": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/reviewedAt"}]},
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100000,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/rowDecision"}
        },
        "sources": {
          "type": "array",
          "maxItems": 6400000,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sourceDecision"}
        }
      }
    }
  }
}
