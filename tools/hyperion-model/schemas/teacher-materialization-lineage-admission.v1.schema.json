{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daxalgo.local/schemas/vibe-quant/teacher-materialization-lineage-admission.v1.schema.json",
  "title": "Vibe Quant teacher materialization lineage admission v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "lineageAdmissionId",
    "scope",
    "decision",
    "reusable",
    "reviewReceiptIssuanceAuthorized",
    "runtimeAttested",
    "teacherWeightsAttested",
    "teacherCorrectnessAuthorized",
    "reviewDecisionAuthorized",
    "rightsAuthorized",
    "releaseAuthorized",
    "trainingAuthorized",
    "evaluationAuthorized",
    "promotionDecisionAuthorized",
    "deploymentAuthorized",
    "hostedServingAuthorized",
    "installationAuthorized",
    "verifierExecutionAuthorized",
    "strategyExecutionAuthorized",
    "reviewerId",
    "reviewedAtUtc",
    "issuedAtUtc",
    "notBeforeUtc",
    "expiresAtUtc",
    "reviewerEvidence",
    "reviewedCorpus",
    "materialization",
    "runtimeObservation",
    "statement"
  ],
  "properties": {
    "schemaVersion": {"const": "daxalgo.vibe-quant.teacher-materialization-lineage-admission/v1"},
    "lineageAdmissionId": {"type": "string", "pattern": "^vqtlineage-[0-9a-f]{64}$"},
    "scope": {"const": "exact-open-weight-teacher-materialization-lineage-for-review-receipt-issuance-only"},
    "decision": {"const": "admitted"},
    "reusable": {"const": true},
    "reviewReceiptIssuanceAuthorized": {"const": true},
    "runtimeAttested": {"const": false},
    "teacherWeightsAttested": {"const": false},
    "teacherCorrectnessAuthorized": {"const": false},
    "reviewDecisionAuthorized": {"const": false},
    "rightsAuthorized": {"const": false},
    "releaseAuthorized": {"const": false},
    "trainingAuthorized": {"const": false},
    "evaluationAuthorized": {"const": false},
    "promotionDecisionAuthorized": {"const": false},
    "deploymentAuthorized": {"const": false},
    "hostedServingAuthorized": {"const": false},
    "installationAuthorized": {"const": false},
    "verifierExecutionAuthorized": {"const": false},
    "strategyExecutionAuthorized": {"const": false},
    "reviewerId": {"$ref": "#/$defs/id"},
    "reviewedAtUtc": {"$ref": "#/$defs/utcSecond"},
    "issuedAtUtc": {"$ref": "#/$defs/utcSecond"},
    "notBeforeUtc": {"$ref": "#/$defs/utcSecond"},
    "expiresAtUtc": {"$ref": "#/$defs/utcSecond"},
    "reviewerEvidence": {"$ref": "#/$defs/reviewerEvidence"},
    "reviewedCorpus": {"$ref": "#/$defs/reviewedCorpus"},
    "materialization": {"$ref": "#/$defs/materialization"},
    "runtimeObservation": {"$ref": "#/$defs/runtimeObservation"},
    "statement": {"const": "This signed decision admits only the exact OpenWeightTeacher materialization lineage and exact reviewed-corpus bytes for review-receipt issuance. It binds an explicitly unattested runtime observation and does not attest runtime or weight identity, correctness, rights, review correctness, release, training, evaluation, promotion, deployment, hosted serving, installation, verifier execution, or strategy execution."}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "utcSecond": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"},
    "reviewerEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "sizeBytes"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "sizeBytes": {"type": "integer", "minimum": 1, "maximum": 16000000}
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exampleId", "stableSubjectSha256", "knowledgeClass", "teacherAdmissionSha256"],
      "properties": {
        "exampleId": {"$ref": "#/$defs/id"},
        "stableSubjectSha256": {"$ref": "#/$defs/sha256"},
        "knowledgeClass": {"enum": ["candidate-stable", "retrieval-only"]},
        "teacherAdmissionSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "reviewedCorpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "sizeBytes", "recordCount", "openWeightTeacherRecordCount", "subjects"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "sizeBytes": {"type": "integer", "minimum": 1, "maximum": 100000000},
        "recordCount": {"type": "integer", "minimum": 1, "maximum": 100000},
        "openWeightTeacherRecordCount": {"type": "integer", "minimum": 1, "maximum": 10000},
        "subjects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/subject"}
        }
      }
    },
    "materialization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "materializationId",
        "materializationRecordSha256",
        "draftDatasetSha256",
        "draftDatasetSizeBytes",
        "draftRecordCount",
        "packageTreeSchemaVersion",
        "packageTreeSha256",
        "packageFileCount",
        "packageSizeBytes",
        "selectionManifestSha256",
        "candidateSetSha256",
        "generationManifestSha256",
        "candidateCatalogSha256",
        "overlapDenySetSha256",
        "overlapDenySetId",
        "overlapScopeSha256",
        "candidateBatchId"
      ],
      "properties": {
        "materializationId": {"type": "string", "pattern": "^vqtmat-[0-9a-f]{64}$"},
        "materializationRecordSha256": {"$ref": "#/$defs/sha256"},
        "draftDatasetSha256": {"$ref": "#/$defs/sha256"},
        "draftDatasetSizeBytes": {"type": "integer", "minimum": 1, "maximum": 100000000},
        "draftRecordCount": {"type": "integer", "minimum": 1, "maximum": 10000},
        "packageTreeSchemaVersion": {"const": "daxalgo.vibe-quant.teacher-materialization-package-tree/v1"},
        "packageTreeSha256": {"$ref": "#/$defs/sha256"},
        "packageFileCount": {"type": "integer", "minimum": 1, "maximum": 100100},
        "packageSizeBytes": {"type": "integer", "minimum": 1, "maximum": 512000000},
        "selectionManifestSha256": {"$ref": "#/$defs/sha256"},
        "candidateSetSha256": {"$ref": "#/$defs/sha256"},
        "generationManifestSha256": {"$ref": "#/$defs/sha256"},
        "candidateCatalogSha256": {"$ref": "#/$defs/sha256"},
        "overlapDenySetSha256": {"$ref": "#/$defs/sha256"},
        "overlapDenySetId": {"$ref": "#/$defs/id"},
        "overlapScopeSha256": {"$ref": "#/$defs/sha256"},
        "candidateBatchId": {"type": "string", "pattern": "^vqtgen-[0-9a-f]{64}$"}
      }
    },
    "runtimeObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceStatus", "runtimeBindingFileSha256", "runtimeBindingSha256", "candidateCatalogSha256", "runtimeDescriptorSha256", "chatTemplateSha256", "executionModelId"],
      "properties": {
        "evidenceStatus": {"const": "unattested-observation"},
        "runtimeBindingFileSha256": {"$ref": "#/$defs/sha256"},
        "runtimeBindingSha256": {"$ref": "#/$defs/sha256"},
        "candidateCatalogSha256": {"$ref": "#/$defs/sha256"},
        "runtimeDescriptorSha256": {"$ref": "#/$defs/sha256"},
        "chatTemplateSha256": {"$ref": "#/$defs/sha256"},
        "executionModelId": {"type": "string", "pattern": "^daxalgo-teacher-sha256-[0-9a-f]{64}$"}
      }
    }
  }
}
