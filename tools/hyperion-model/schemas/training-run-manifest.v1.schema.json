{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daxalgo.local/schemas/vibe-quant/training-run-manifest.v1.schema.json",
  "title": "Vibe Quant QLoRA-SFT training-run manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "createdAtUtc",
    "baseModel",
    "candidateCatalog",
    "dataset",
    "method",
    "seed",
    "chatTemplate",
    "hyperparameters",
    "outputPath",
    "domains",
    "trainingRuntime"
  ],
  "properties": {
    "schemaVersion": {"const": "daxalgo.vibe-quant.training-run/v1"},
    "runId": {"type": "string", "pattern": "^vqrun-[0-9a-f]{20}$"},
    "createdAtUtc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "baseModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateId", "modelId", "revision", "license", "officialSourceUrl"],
      "properties": {
        "candidateId": {"type": "string", "minLength": 1},
        "modelId": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "license": {"type": "string", "minLength": 1},
        "officialSourceUrl": {"type": "string", "format": "uri", "pattern": "^https://"}
      }
    },
    "candidateCatalog": {"$ref": "#/$defs/fileBinding"},
    "dataRelease": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/releaseIdentity"}
      ]
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "format", "recordCount", "sourceSchemaVersions"],
      "properties": {
        "path": {"const": "inputs/dataset.sft.jsonl"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "format": {"const": "expert-model-sft-jsonl"},
        "recordCount": {"type": "integer", "minimum": 1},
        "sourceSchemaVersions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"const": "expert-model-dataset/v1"}
        }
      }
    },
    "method": {"const": "QLoRA-SFT"},
    "seed": {"type": "integer", "minimum": 0, "maximum": 2147483647},
    "chatTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "template", "sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "template": {"type": "string", "minLength": 64},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "hyperparameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numTrainEpochs",
        "learningRate",
        "perDeviceTrainBatchSize",
        "gradientAccumulationSteps",
        "maxSequenceLength",
        "warmupRatio",
        "weightDecay",
        "loraR",
        "loraAlpha",
        "loraDropout",
        "loraTargetModules",
        "quantizationBits",
        "gradientCheckpointing",
        "optimizer",
        "lrScheduler"
      ],
      "properties": {
        "numTrainEpochs": {"type": "number", "exclusiveMinimum": 0, "maximum": 50},
        "learningRate": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "perDeviceTrainBatchSize": {"type": "integer", "minimum": 1, "maximum": 256},
        "gradientAccumulationSteps": {"type": "integer", "minimum": 1, "maximum": 4096},
        "maxSequenceLength": {"type": "integer", "minimum": 128, "maximum": 262144},
        "warmupRatio": {"type": "number", "minimum": 0, "exclusiveMaximum": 1},
        "weightDecay": {"type": "number", "minimum": 0, "maximum": 1},
        "loraR": {"type": "integer", "minimum": 1, "maximum": 1024},
        "loraAlpha": {"type": "integer", "minimum": 1, "maximum": 8192},
        "loraDropout": {"type": "number", "minimum": 0, "exclusiveMaximum": 1},
        "loraTargetModules": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"}
        },
        "quantizationBits": {"const": 4},
        "gradientCheckpointing": {"type": "boolean"},
        "optimizer": {"const": "paged_adamw_8bit"},
        "lrScheduler": {"const": "cosine"}
      }
    },
    "outputPath": {"const": "outputs/adapter"},
    "domains": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "CSharp",
          "DaxAlgoArchitecture",
          "QuantitativeMath",
          "ProbabilityStatistics",
          "RiskManagement",
          "PortfolioManagement",
          "FinanceMarkets",
          "WpfUiDesign"
        ]
      }
    },
    "trainingRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "pylock"],
      "properties": {
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {"const": "inputs/training-runtime-profile.json"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "pylock": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {"const": "inputs/pylock.train.toml"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      }
    }
  },
  "$defs": {
    "releaseIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["releaseId", "releaseSha256", "manifestSha256"],
      "properties": {
        "releaseId": {"type": "string", "pattern": "^vqrel-[0-9a-f]{64}$"},
        "releaseSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "manifestSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"const": "inputs/candidate-catalog.json"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
