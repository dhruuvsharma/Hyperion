<mah:MetroWindow x:Class="TradingTerminal.App.Authoring.HostedStrategyAuthoringWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 Title="Hosted Hyperion authoring"
                 Width="1040" Height="760" MinWidth="820" MinHeight="620"
                 ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 Icon="pack://application:,,,/TradingTerminal.App;component/Icon/DaxAlgoLogo.ico"
                 Background="{DynamicResource Background.Primary}"
                 Foreground="{DynamicResource Text.Primary}"
                 FontFamily="{DynamicResource Font.Mono}"
                 FontSize="12">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Border DockPanel.Dock="Right" Padding="10,4" CornerRadius="4"
                    Background="{DynamicResource Warning.Brush}">
                <TextBlock Text="INERT SOURCE ONLY" Foreground="Black" FontWeight="Bold" />
            </Border>
            <StackPanel>
                <TextBlock Text="DaxAlgo Expert · hosted authoring" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource Text.Header}" />
                <TextBlock Text="Server-owned model, budget and credits · two exact-hash approvals · inert source only"
                           Margin="0,3,0,0" Foreground="{DynamicResource Text.Secondary}" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Padding="12" Margin="0,0,0,10"
                Background="{DynamicResource Background.Elevated}"
                BorderBrush="{DynamicResource Border.Brush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="STRATEGY OBJECTIVE" FontWeight="Bold" FontSize="10"
                               Foreground="{DynamicResource Text.Secondary}" />
                    <TextBox Text="{Binding Objective, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="{Binding IsObjectiveReadOnly}"
                             MaxLength="20000" MinHeight="68" Margin="0,5,0,0"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             mah:TextBoxHelper.Watermark="Describe the strategy, instruments, timeframe, risk limits, and evidence requirements." />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="PLATFORM CREDITS" FontWeight="Bold" FontSize="10"
                               Foreground="{DynamicResource Text.Secondary}" />
                    <TextBlock Text="{Binding CreditSummary}" Margin="0,7,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ConfigurationMessage}" Margin="0,7,0,0" TextWrapping="Wrap"
                               FontSize="10.5" Foreground="{DynamicResource Text.Secondary}" />
                    <Button Content="Refresh connection and credits" Command="{Binding InitializeCommand}"
                            Padding="10,4" Margin="0,9,0,0" HorizontalAlignment="Left" />
                    <Button Content="{Binding DiscardRecoveryText}" Command="{Binding DiscardRecoveryCommand}"
                            Padding="10,4" Margin="0,6,0,0" HorizontalAlignment="Left" />
                    <TextBox Text="{Binding RecoveryDiscardConfirmation, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsDiscardRecoveryArmed}" MaxLength="7" Margin="0,5,0,0"
                             mah:TextBoxHelper.Watermark="Type DISCARD to confirm" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Padding="12" Margin="0,0,0,10"
                Background="{DynamicResource Background.Elevated}"
                BorderBrush="{DynamicResource Border.Brush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding SpecificationSummary}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding RunCreditSummary}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Text.Secondary}" />
                    <Expander Header="Inspect exact server specification before approving Start"
                              Margin="0,6,0,0">
                        <TextBox Text="{Binding SpecificationDetails, Mode=OneWay}"
                                 IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                 MaxHeight="170" Padding="7" BorderThickness="1"
                                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                 FontFamily="{DynamicResource Font.Data}" FontSize="10.5" />
                    </Expander>
                    <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource Text.Secondary}">
                        <Run Text="State: " /><Run Text="{Binding RunStatusText, Mode=OneWay}" FontWeight="Bold" />
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="1 · Create quote" Command="{Binding SubmitCommand}" Padding="12,5" />
                    <Button Content="2 · Approve charge &amp; start" Command="{Binding StartCommand}"
                            Padding="12,5" Margin="7,0,0,0"
                            Style="{DynamicResource MahApps.Styles.Button.Square.Accent}" />
                    <Button Content="Refresh status" Command="{Binding RefreshStatusCommand}"
                            Padding="12,5" Margin="7,0,0,0" />
                    <Button Content="Cancel run" Command="{Binding CancelCommand}"
                            Padding="12,5" Margin="7,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <ProgressBar Height="3" IsIndeterminate="{Binding IsBusy}" />
            <TextBlock Text="{Binding Message}" Margin="2,7,2,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource Accent.Brush}" />
        </StackPanel>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="{DynamicResource Border.Brush}" BorderThickness="1"
                    Background="{DynamicResource Background.Elevated}" Padding="8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="3,2,3,8">
                        <TextBlock Text="READ-ONLY SOURCE PREVIEW" FontWeight="Bold" FontSize="10"
                                   Foreground="{DynamicResource Text.Secondary}" />
                        <TextBlock Text="{Binding ArtifactSummary}" Margin="0,5,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="RISK JUDGE REVIEW" Margin="0,12,0,0"
                                   FontWeight="Bold" FontSize="10"
                                   Foreground="{DynamicResource Warning.Brush}" />
                        <ScrollViewer MaxHeight="170" Margin="0,4,0,0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="{Binding RiskReviewSummary}"
                                           TextWrapping="Wrap" FontSize="10.5" />
                                <ItemsControl ItemsSource="{Binding RiskReviewItems}" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                       FontSize="9.5" Foreground="{DynamicResource Text.Secondary}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}"
                             Background="Transparent" BorderThickness="0"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,5">
                                    <TextBlock Text="{Binding RelativePath}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding ShortHash}" FontSize="9.5"
                                               Foreground="{DynamicResource Text.Secondary}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch"
                          Background="{DynamicResource Border.Brush}" />

            <Border Grid.Column="2" BorderBrush="{DynamicResource Border.Brush}" BorderThickness="1"
                    Background="{DynamicResource Background.Elevated}" Padding="1">
                <TextBox Text="{Binding SelectedFile.Content, Mode=OneWay}"
                         IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True"
                         TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="10"
                         FontFamily="{DynamicResource Font.Data}" FontSize="11.5"
                         Background="Transparent" Foreground="{DynamicResource Text.Primary}" />
            </Border>
        </Grid>

        <DockPanel Grid.Row="5" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Close" Command="{Binding CloseCommand}"
                    Padding="16,6" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Content="4 · Import released source"
                    Command="{Binding ImportCommand}" Padding="16,6" Margin="8,0,0,0"
                    Style="{DynamicResource MahApps.Styles.Button.Square.Accent}" />
            <Button DockPanel.Dock="Right" Content="3 · Release exact preview"
                    Command="{Binding ReleaseCommand}" Padding="16,6" />
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="560"
                       Foreground="{DynamicResource Text.Secondary}"
                       Text="Import never compiles or installs. The main editor's Compile &amp; Register action remains a second, local code-review gate." />
        </DockPanel>
    </Grid>
</mah:MetroWindow>
